DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True
SECRET_KEY=change-me
COMPOSE_PROJECT_NAME=sescco-local
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_DOMAIN=http://localhost
ACME_EMAIL=admin@example.com
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=60
POSTGRES_DB=company_profile
POSTGRES_USER=company_profile
POSTGRES_PASSWORD=company_profile
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@example.com
SERVER_EMAIL=info@example.com

# Career application uploads and spam protection
CAREER_MAX_UPLOAD_SIZE=8388608
CAREER_APPLICATION_RATE_LIMIT_COUNT=5
CAREER_APPLICATION_RATE_LIMIT_WINDOW=3600

# In production keep applicant documents on private storage / private media.
# The dashboard serves CVs and documents through staff-only secure download URLs.
MEDIA_ROOT=media
MEDIA_URL=/media/

# Career email verification
CAREER_EMAIL_OTP_EXPIRY_MINUTES=15
CAREER_EMAIL_OTP_MAX_ATTEMPTS=6
CAREER_EMAIL_OTP_RATE_LIMIT_COUNT=5
CAREER_EMAIL_OTP_RATE_LIMIT_WINDOW=3600
