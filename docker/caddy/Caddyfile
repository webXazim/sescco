{
    email {$ACME_EMAIL:admin@example.com}
    servers {
        # Preserve the original client and HTTPS scheme when this site sits
        # behind a shared host-level proxy on a multi-site VPS.
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
}

{$SITE_DOMAIN:http://localhost} {
    encode gzip zstd
    request_body {
        max_size 16MB
    }

    handle_path /static/* {
        root * /srv/static
        file_server {
            precompressed br gzip
        }
        # collectstatic emits content-hashed filenames, so browsers and CDNs can
        # retain them permanently without revalidation on repeat page visits.
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Applicant CVs and supporting documents are only served by authenticated
    # Django dashboard views. Never expose their storage path through Caddy.
    @privateCareerFiles path /media/careers/private/applications/* /media/careers/applications/*
    handle @privateCareerFiles {
        respond 404
    }

    handle_path /media/* {
        root * /srv/media
        file_server
        header Cache-Control "public, max-age=604800"
    }

    reverse_proxy web:8000 {
        header_up Host {host}
    }
}
